{
  "openapi": "3.0.1",
  "info": {
    "title": "EDS Data API",
    "description": "History and Employee data for the EDS Power App, backed by Azure SQL via func-eds-dev.",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "https://apim-eds-dev.azure-api.net/eds"
    }
  ],
  "paths": {
    "/history": {
      "get": {
        "summary": "List history",
        "description": "Latest packages, newest first. All filters are optional and combine with AND.",
        "operationId": "history-list",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number, 1-based.",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Rows per page, 1-200.",
            "schema": {
              "type": "integer",
              "default": 50
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Notified | Delivered. A value of Identified or Unknown is applied to data_type.",
            "schema": {
              "type": "string",
              "enum": [
                "Notified",
                "Delivered"
              ]
            }
          },
          {
            "name": "data_type",
            "in": "query",
            "description": "Identified | Unknown.",
            "schema": {
              "type": "string",
              "enum": [
                "Identified",
                "Unknown"
              ]
            }
          },
          {
            "name": "employee_id",
            "in": "query",
            "description": "Recipient employee code.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "notified_start",
            "in": "query",
            "description": "Inclusive lower bound on notified_at.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "notified_end",
            "in": "query",
            "description": "Inclusive upper bound on notified_at.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "delivered_start",
            "in": "query",
            "description": "Inclusive lower bound on delivered_at.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "delivered_end",
            "in": "query",
            "description": "Inclusive upper bound on delivered_at.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "slip_no",
            "in": "query",
            "description": "伝票番号 (contains)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "recipient_name",
            "in": "query",
            "description": "受取人 (contains; 不明 = no recipient)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search_keyword",
            "in": "query",
            "description": "Any of 伝票番号, 受取人, 処理状態, データ区分, 通知日時 (contains)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tz_offset",
            "in": "query",
            "description": "Power Fx TimeZoneOffset() (minutes, UTC minus local). Default -540 (Japan).",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching packages."
          }
        }
      },
      "post": {
        "summary": "Append history",
        "description": "Appends one package. Call at the end of the capture flow. Returns history_id. Also writes the matching ocr_history row (same transaction) with operator_name / operator_email.",
        "operationId": "history-insert",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "slip_no",
                  "image_url"
                ],
                "properties": {
                  "slip_no": {
                    "type": "string"
                  },
                  "image_url": {
                    "type": "string"
                  },
                  "sender_name": {
                    "type": "string"
                  },
                  "sender_content": {
                    "type": "string"
                  },
                  "sender_address": {
                    "type": "string"
                  },
                  "employee_id": {
                    "type": "string"
                  },
                  "recipient_name": {
                    "type": "string"
                  },
                  "recipient_department_name": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "Notified",
                      "Delivered"
                    ],
                    "default": "Notified"
                  },
                  "data_type": {
                    "type": "string",
                    "enum": [
                      "Identified",
                      "Unknown"
                    ]
                  },
                  "notified_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "planner_task_id": {
                    "type": "string",
                    "nullable": true
                  },
                  "operator_name": {
                    "type": "string",
                    "nullable": true,
                    "description": "Who pressed Register (Power Apps User().FullName)."
                  },
                  "operator_email": {
                    "type": "string",
                    "nullable": true,
                    "description": "Their e-mail (User().Email)."
                  }
                }
              },
              "example": {
                "slip_no": "1989-2173-2192",
                "image_url": "data:image/jpeg;base64,...",
                "sender_name": "山田 花子",
                "sender_content": "契約書類",
                "sender_address": "東京都千代田区丸の内1-1-1",
                "employee_id": "1060002002",
                "recipient_name": "大野朱音",
                "recipient_department_name": "経営企画部",
                "status": "Notified",
                "data_type": "Identified",
                "notified_at": "2026-09-10T10:00:00.0000000+00:00",
                "planner_task_id": null,
                "operator_name": "受付 花子",
                "operator_email": "hanako@smartosc.com"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created; body contains history_id."
          }
        }
      }
    },
    "/history/delivered": {
      "post": {
        "summary": "Mark delivered",
        "description": "Records delivered_at and sets status to Delivered. Replaying a completion does not move delivered_at. Identify the package by planner_task_id or history_id.",
        "operationId": "history-delivered",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "planner_task_id": "vJKMDVFT9UmMe9_5-3vTNGUAB1Ib"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated."
          },
          "404": {
            "description": "No package is linked to that Planner task."
          }
        }
      }
    },
    "/history/planner-sync": {
      "post": {
        "summary": "Sync status from Planner",
        "description": "Called by the scheduled flow EDS-PlannerStatusSync with every task of the EDS Planner plan. Tasks reopened in Planner go back to Notified (delivered_at cleared); completed tasks still Notified become Delivered. Only the tasks in the request are touched. Rows delivered after snapshot_at are not reverted. When more than max_revert rows would be reverted, nothing changes and 409 is returned.",
        "operationId": "history-planner-sync",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "snapshot_at": "2026-10-14T10:00:00Z",
                "max_revert": 50,
                "tasks": [
                  {
                    "planner_task_id": "vJKMDVFT9UmMe9_5-3vTNGUAB1Ib",
                    "completed": true,
                    "completed_at": "2026-10-14T03:12:00Z"
                  },
                  {
                    "planner_task_id": "aB12cd34Ef56gh78Ij90kl12Mn34",
                    "completed": false,
                    "completed_at": null
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Synced; body is { checked, reverted, delivered, duplicates }."
          },
          "400": {
            "description": "Missing snapshot_at, bad max_revert, or a malformed task entry."
          },
          "409": {
            "description": "More rows than max_revert would go back to Notified; nothing was changed."
          }
        }
      }
    },
    "/history/{id}/planner-task": {
      "patch": {
        "summary": "Link Planner task",
        "description": "Stores the Planner task id on a package. Required for completion lookup.",
        "operationId": "history-planner",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "history_id returned by Append history.",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "planner_task_id": "vJKMDVFT9UmMe9_5-3vTNGUAB1Ib"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Linked."
          },
          "404": {
            "description": "history_id not found."
          }
        }
      }
    },
    "/employees": {
      "get": {
        "summary": "List employees",
        "description": "Paginated employees. department_name and search_keyword are optional and combine with AND.",
        "operationId": "employee-list",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number, 1-based.",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Rows per page, 1-200.",
            "schema": {
              "type": "integer",
              "default": 50
            }
          },
          {
            "name": "employee_id",
            "in": "query",
            "description": "社員番号 (contains)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "full_name",
            "in": "query",
            "description": "社員氏名 (contains)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "email",
            "in": "query",
            "description": "メール (contains)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "department_name",
            "in": "query",
            "description": "部署 (contains)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "created_start",
            "in": "query",
            "description": "登録日時 From (inclusive)",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "created_end",
            "in": "query",
            "description": "登録日時 To (inclusive)",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "search_keyword",
            "in": "query",
            "description": "Any of 社員番号, 社員氏名, メール, 部署, 登録日時, 更新日時 (contains)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tz_offset",
            "in": "query",
            "description": "Power Fx TimeZoneOffset() (minutes, UTC minus local). Default -540 (Japan).",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching employees."
          }
        }
      },
      "post": {
        "summary": "Insert employee",
        "description": "Inserts a new employee. employee_id is the employee code. full_name, department_name, and email are required.",
        "operationId": "employee-insert",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "employee_id",
                  "full_name",
                  "department_name",
                  "email"
                ],
                "properties": {
                  "employee_id": {
                    "type": "string"
                  },
                  "full_name": {
                    "type": "string"
                  },
                  "department_name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "employee_id": "1060002002",
                "full_name": "大野朱音",
                "department_name": "経営企画部",
                "email": "a-ono@exeo-digitalsolutions.co.jp"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created."
          },
          "400": {
            "description": "Missing required fields."
          },
          "409": {
            "description": "employee_id or email is already used by another employee."
          }
        }
      }
    },
    "/employees/import": {
      "post": {
        "summary": "Import employees",
        "description": "Upserts employees from a CSV. Send the file text in csv, or the base64 file bytes in csv_base64. Header columns: 社員番号, 社員氏名, メール, 部署.",
        "operationId": "employee-import",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "csv": {
                    "type": "string"
                  },
                  "csv_base64": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "csv_base64": "<base64 of the CSV file>"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Import finished. Body has success, total, inserted, updated, skipped, messages, and errorFile."
          },
          "400": {
            "description": "csv and csv_base64 are missing, or the CSV cannot be parsed."
          },
          "413": {
            "description": "File is too large."
          },
          "422": {
            "description": "No valid data rows."
          },
          "503": {
            "description": "Database connection was lost and the import was rolled back."
          }
        }
      }
    },
    "/employees/export": {
      "get": {
        "summary": "Download employees as CSV",
        "operationId": "employee-export",
        "description": "Builds a CSV (社員番号, 社員氏名, メール, 部署 - the import file columns) of the employees matching the same filters as GET /employees except 登録日時 (created_start / created_end are ignored) (all when none) in Blob Storage and returns a 15-minute download link.",
        "parameters": [
          {
            "name": "employee_id",
            "in": "query",
            "description": "社員番号 (contains)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "full_name",
            "in": "query",
            "description": "社員氏名 (contains)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "email",
            "in": "query",
            "description": "メール (contains)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "department_name",
            "in": "query",
            "description": "部署 (contains)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search_keyword",
            "in": "query",
            "description": "Any of 社員番号, 社員氏名, メール, 部署, 登録日時, 更新日時 (contains)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tz_offset",
            "in": "query",
            "description": "Power Fx TimeZoneOffset() (minutes, UTC minus local). Default -540 (Japan).",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "File ready",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "rowCount": {
                      "type": "integer"
                    },
                    "totalCount": {
                      "type": "integer"
                    },
                    "file": {
                      "type": "object",
                      "properties": {
                        "fileName": {
                          "type": "string"
                        },
                        "contentType": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string"
                        },
                        "expiresOn": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Blob Storage not configured"
          }
        }
      }
    },
    "/employees/match": {
      "get": {
        "summary": "Match OCR name",
        "description": "Ranked candidate recipients for an OCR-read name. The name must already be normalised (NFKC, katakana to hiragana, whitespace stripped).",
        "operationId": "employee-match",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "description": "Normalised name from normalize.js.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "department_name",
            "in": "query",
            "description": "OCR department name, adds to the match score.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "top",
            "in": "query",
            "description": "Candidates to return, 1-50.",
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Candidates with match_score, best first."
          }
        }
      }
    },
    "/employees/fuzzy-search": {
      "get": {
        "summary": "Fuzzy search employees",
        "description": "OCR receiver fuzzy match against dbo.employee. Candidates use the Office Script schema: employee_id, name, department, email, name_score, department_score, score.",
        "operationId": "employee-fuzzy-search",
        "parameters": [
          {
            "name": "receiver_name",
            "in": "query",
            "description": "OCR receiver name. Empty returns the first top_k roster rows.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "department",
            "in": "query",
            "description": "OCR department.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name_weight",
            "in": "query",
            "description": "Name score weight 0-1.",
            "schema": {
              "type": "number",
              "default": 0.85
            }
          },
          {
            "name": "top_k",
            "in": "query",
            "description": "Weak-candidate count when no exact name match.",
            "schema": {
              "type": "integer",
              "default": 3
            }
          },
          {
            "name": "fuzzy_threshold",
            "in": "query",
            "description": "If the best fuzzy score is above this, return top 1.",
            "schema": {
              "type": "number",
              "default": 90
            }
          }
        ],
        "responses": {
          "200": {
            "description": "match_type and candidates."
          }
        }
      },
      "post": {
        "summary": "Fuzzy search employees",
        "description": "Same as GET. Accepts snake_case or camelCase body fields (receiverName, nameWeight, topK, fuzzyThreshold).",
        "operationId": "employee-fuzzy-search-post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "receiver_name": {
                    "type": "string"
                  },
                  "receiverName": {
                    "type": "string"
                  },
                  "department": {
                    "type": "string"
                  },
                  "name_weight": {
                    "type": "number",
                    "default": 0.85
                  },
                  "nameWeight": {
                    "type": "number",
                    "default": 0.85
                  },
                  "top_k": {
                    "type": "integer",
                    "default": 3
                  },
                  "topK": {
                    "type": "integer",
                    "default": 3
                  },
                  "fuzzy_threshold": {
                    "type": "number",
                    "default": 90
                  },
                  "fuzzyThreshold": {
                    "type": "number",
                    "default": 90
                  }
                }
              },
              "example": {
                "receiverName": "前川 雄亮",
                "department": "総務部",
                "nameWeight": 0.85,
                "topK": 3,
                "fuzzyThreshold": 90
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "match_type and candidates."
          }
        }
      }
    },
    "/employees/{id}": {
      "patch": {
        "summary": "Update employee",
        "description": "Updates full_name, department_name, and email for an existing employee_id. The id itself is not changed.",
        "operationId": "employee-update",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "employee_id to update.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "full_name",
                  "department_name",
                  "email"
                ],
                "properties": {
                  "full_name": {
                    "type": "string"
                  },
                  "department_name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "full_name": "前川 雄亮",
                "department_name": "第２営業本部",
                "email": "kietna2@smartosc.com"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated. Body contains value with the employee row."
          },
          "400": {
            "description": "Missing required fields."
          },
          "404": {
            "description": "employee_id not found."
          }
        }
      },
      "delete": {
        "summary": "Delete employee",
        "description": "Deletes the employee by employee_id. History rows keep the employee_id snapshot.",
        "operationId": "employee-delete",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "employee_id to delete.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted."
          },
          "404": {
            "description": "employee_id not found."
          }
        }
      }
    },
    "/ocr-history": {
      "post": {
        "summary": "Append OCR log",
        "description": "Stores one OCR read. slip_no, image_url, and data_type are required. status defaults to Notified. data_type is Identified or Unknown. status is Notified or Delivered.",
        "operationId": "ocr-history-insert",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "slip_no",
                  "image_url",
                  "data_type"
                ],
                "properties": {
                  "history_id": {
                    "type": "integer",
                    "nullable": true
                  },
                  "slip_no": {
                    "type": "string"
                  },
                  "image_url": {
                    "type": "string"
                  },
                  "sender_name": {
                    "type": "string"
                  },
                  "sender_content": {
                    "type": "string"
                  },
                  "sender_address": {
                    "type": "string"
                  },
                  "employee_id": {
                    "type": "string"
                  },
                  "recipient_name": {
                    "type": "string"
                  },
                  "recipient_department_name": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "Notified",
                      "Delivered"
                    ],
                    "default": "Notified"
                  },
                  "data_type": {
                    "type": "string",
                    "enum": [
