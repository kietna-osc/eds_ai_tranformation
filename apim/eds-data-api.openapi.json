    "/images": {
      "post": {
        "summary": "Store a scanned image and its preview",
        "description": "Stores the original and a 320 px JPEG preview in Blob Storage (container history-images). Returns image_url (the blob URL stored in dbo.history.image_url) and the blob paths; pass image_blob_path to POST /history. Called by EDS-NotifySelected.",
        "operationId": "image-upload",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "content"
                ],
                "properties": {
                  "content": {
                    "type": "string",
                    "description": "Base64 image or data URI (data:image/jpeg;base64,...). Max 10 MB."
                  },
                  "content_type": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Stored",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "image_blob_path": {
                      "type": "string"
                    },
                    "preview_blob_path": {
                      "type": "string"
                    },
                    "content_type": {
                      "type": "string"
                    },
                    "width": {
                      "type": "integer"
                    },
                    "height": {
                      "type": "integer"
                    },
                    "image_bytes": {
                      "type": "integer"
                    },
                    "preview_bytes": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing, not base64, or not an image"
          }
        }
      }
    },
    "/history/export": {
      "get": {
        "summary": "Download History as CSV",
        "operationId": "history-export",
        "description": "Builds a CSV of the History rows matching the same filters as GET /history (all rows when none) in Blob Storage and returns a 15-minute download link.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "Notified | Delivered. A value of Identified or Unknown is applied to data_type.",
            "schema": {
              "type": "string",
              "enum": [
                "Notified",
                "Delivered"
              ]
            }
          },
          {
            "name": "data_type",
            "in": "query",
            "description": "Identified | Unknown.",
            "schema": {
              "type": "string",
              "enum": [
                "Identified",
                "Unknown"
              ]
            }
          },
          {
            "name": "employee_id",
            "in": "query",
            "description": "Recipient employee code.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "notified_start",
            "in": "query",
            "description": "Inclusive lower bound on notified_at.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "notified_end",
            "in": "query",
            "description": "Inclusive upper bound on notified_at.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "delivered_start",
            "in": "query",
            "description": "Inclusive lower bound on delivered_at.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "delivered_end",
            "in": "query",
            "description": "Inclusive upper bound on delivered_at.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "slip_no",
            "in": "query",
            "description": "伝票番号 (contains)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "recipient_name",
            "in": "query",
            "description": "受取人 (contains; 不明 = no recipient)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search_keyword",
            "in": "query",
            "description": "Any of 伝票番号, 受取人, 処理状態, データ区分, 通知日時 (contains)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tz_offset",
            "in": "query",
            "description": "Power Fx TimeZoneOffset() (minutes, UTC minus local). Default -540 (Japan).",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "File ready",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "rowCount": {
                      "type": "integer"
                    },
                    "totalCount": {
                      "type": "integer"
                    },
                    "searchKeyword": {
                      "type": "string",
                      "nullable": true
                    },
                    "file": {
                      "type": "object",
                      "properties": {
                        "fileName": {
                          "type": "string"
                        },
                        "contentType": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string"
                        },
                        "expiresOn": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Blob Storage not configured"
          }
        }
      }
    }
