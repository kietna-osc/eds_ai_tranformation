                "client_name": {
                  "type": "string"
                },
                "client_department": {
                  "type": "string"
                },
                "clientNumber": {
                  "type": "string"
                },
                "clientItem": {
                  "type": "string"
                },
                "confidence": {
                  "type": "number"
                }
              }
            }
          },
          "runAfter": {
            "HTTP_OpenAI_extract": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "5693a8c6-2287-400a-a315-8c7e14fa03d4"
          }
        },
        "Compose_OCRText": {
          "type": "Compose",
          "inputs": "@variables('varAnalyzeResult')",
