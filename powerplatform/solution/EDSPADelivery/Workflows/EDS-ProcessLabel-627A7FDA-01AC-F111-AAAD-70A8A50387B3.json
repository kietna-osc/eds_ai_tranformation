                  "transferMode": "Chunked"
                }
              }
            }
          },
          "runAfter": {
            "OperationLocation": [
              "Succeeded"
            ]
          }
        },
        "OperationLocation": {
          "type": "Compose",
          "inputs": "@outputs('HTTP_call_to_DI')?['headers']?['Operation-Location']",
          "runAfter": {
            "HTTP_Call_to_DI": [
              "Succeeded"
            ]
          }
        },
        "Condition_status": {
          "type": "If",
          "expression": {
            "and": [
              {
                "equals": [
                  "@body('HTTP_Get_DI_result')?['status']",
