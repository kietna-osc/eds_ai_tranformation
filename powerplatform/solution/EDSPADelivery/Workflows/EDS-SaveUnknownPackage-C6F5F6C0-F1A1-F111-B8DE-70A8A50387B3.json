              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "https://smartosc0.sharepoint.com/sites/EDSProcessLabel2",
                  "folderPath": "/UnknownImage",
                  "name": "@if(empty(triggerBody()?['package_id']), triggerBody()?['file']?['name'], concat(triggerBody()?['package_id'], '.jpg'))",
                  "body": "@base64ToBinary(triggerBody()?['file']?['contentBytes'])"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "CreateFile",
                  "connectionName": "shared_sharepointonline"
                }
              },
              "runtimeConfiguration": {
                "contentTransfer": {
                  "transferMode": "Chunked"
                }
              }
            },
            "Create_sharing_link_for_a_file_or_folder": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "https://smartosc0.sharepoint.com/sites/EDSProcessLabel2",
                  "table": "fdca82d7-55a5-4d78-bb56-491cb9469888",
                  "id": "@outputs('Create_file')?['body/ItemId']",
                  "permission/type": "view",
                  "permission/scope": "organization"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "CreateSharingLink",
                  "connectionName": "shared_sharepointonline"
                }
              },
              "runAfter": {
