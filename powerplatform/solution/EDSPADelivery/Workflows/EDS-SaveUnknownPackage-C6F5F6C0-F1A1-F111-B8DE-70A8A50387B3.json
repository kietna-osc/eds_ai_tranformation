              }
            },
            "Set_variable": {
              "type": "SetVariable",
              "inputs": {
                "name": "image_url",
                "value": "@concat('https://smartosc0.sharepoint.com/sites/EDSProcessLabel2/UnknownImage/', body('Create_file')?['Name'])"
              },
              "runAfter": {
                "Create_sharing_link_for_a_file_or_folder": [
                  "Succeeded"
                ]
              }
            }
          },
          "else": {
            "actions": {
              "Set_variable_1": {
                "type": "SetVariable",
                "inputs": {
                  "name": "image_url",
                  "value": "@concat(variables('sharepoint-site'),triggerBody()?['text_9'])"
