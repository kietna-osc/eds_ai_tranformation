{
  "displayName": "EDS-EmployeeImport",
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "$authentication": {
        "defaultValue": {},
        "type": "SecureObject"
      },
      "$connections": {
        "defaultValue": {},
        "type": "Object"
      }
    },
    "triggers": {
      "manual": {
        "type": "Request",
        "kind": "PowerAppV2",
        "inputs": {
          "schema": {
            "type": "object",
            "properties": {
              "file": {
                "description": "Employee CSV file (社員番号,社員氏名,メール,部署)",
                "title": "file",
                "type": "object",
                "properties": {
                  "contentBytes": {
                    "type": "string",
                    "format": "byte"
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "x-ms-content-hint": "FILE",
                "x-ms-dynamically-added": true
              }
            },
            "required": [
              "file"
            ]
          }
        }
      }
    },
    "actions": {
      "Get_auth_token": {
        "runAfter": {},
        "metadata": {
          "operationMetadataId": "31783c68-3578-4803-9331-a70bac3807b0"
        },
        "type": "Http",
        "inputs": {
          "uri": "https://login.microsoftonline.com/d4e484ed-0018-471f-b7c2-3265f48203f3/oauth2/v2.0/token",
          "method": "POST",
          "headers": {
            "Content-Type": "application/x-www-form-urlencoded"
          },
          "body": "grant_type=client_credentials&client_id=53ddbbff-90ae-4085-858e-9923b3c6a3d9&client_secret=<CLIENT_SECRET>&scope=api://652e20e5-6a5a-46c6-a42a-67076fcce01e/.default"
        },
        "runtimeConfiguration": {
          "secureData": {
            "properties": [
              "inputs",
              "outputs"
            ]
          }
        }
      },
      "Import_employees": {
        "runAfter": {
          "Get_auth_token": [
            "Succeeded"
          ]
        },
        "type": "Http",
        "inputs": {
          "uri": "https://apim-eds-dev.azure-api.net/eds/employees/import",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer @{body('Get_auth_token')?['access_token']}",
            "Content-Type": "application/json"
          },
          "body": {
            "csv_base64": "@{triggerBody()?['file']?['contentBytes']}",
            "file_name": "@{triggerBody()?['file']?['name']}"
          },
          "retryPolicy": {
            "type": "none"
          }
        },
        "limit": {
          "timeout": "PT90S"
        }
      },
      "Is_success": {
        "runAfter": {
          "Import_employees": [
            "Succeeded",
            "Failed",
            "TimedOut",
            "Skipped"
          ]
        },
        "type": "If",
        "expression": {
          "and": [
            {
              "equals": [
                "@outputs('Import_employees')?['statusCode']",
                200
              ]
            }
          ]
        },
        "actions": {
          "Respond_success": {
            "runAfter": {},
            "type": "Response",
            "kind": "PowerApp",
            "inputs": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "title": "status",
                    "type": "string",
                    "x-ms-content-hint": "TEXT",
                    "x-ms-dynamically-added": true
                  },
                  "response": {
                    "title": "response",
                    "type": "string",
                    "x-ms-content-hint": "TEXT",
                    "x-ms-dynamically-added": true
                  },
                  "success": {
                    "title": "success",
                    "type": "boolean",
                    "x-ms-content-hint": "BOOLEAN",
                    "x-ms-dynamically-added": true
                  },
                  "success_num": {
                    "title": "success_num",
                    "type": "number",
                    "x-ms-content-hint": "NUMBER",
                    "x-ms-dynamically-added": true
                  },
                  "error": {
                    "title": "error",
                    "type": "string",
                    "x-ms-content-hint": "TEXT",
                    "x-ms-dynamically-added": true
                  },
                  "errorFile": {
                    "title": "errorFile",
                    "type": "string",
                    "x-ms-content-hint": "TEXT",
                    "x-ms-dynamically-added": true
                  }
                },
                "additionalProperties": {}
              },
              "statusCode": 200,
              "body": {
                "status": "@{body('Import_employees')?['status']}",
                "response": "@{string(body('Import_employees'))}",
                "success": true,
                "success_num": "@add(body('Import_employees')?['summary']?['inserted'],body('Import_employees')?['summary']?['updated'])",
                "error": "",
                "errorFile": "@{coalesce(body('Import_employees')?['errorFile']?['url'],'')}"
              }
            }
          }
        },
        "else": {
          "actions": {
            "Parse_error_body": {
              "runAfter": {},
              "type": "ParseJson",
              "inputs": {
                "content": "@body('Import_employees')",
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "error": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "properties": {
                        "code": {
                          "type": [
                            "integer",
                            "string"
                          ]
                        },
                        "reason": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "rowCount": {
                          "type": "integer"
                        },
                        "rows": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "line": {
                                "type": "integer"
                              },
                              "employee_id": {
                                "type": "string"
                              },
                              "errors": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "column": {
                                      "type": "string"
                                    },
                                    "value": {
                                      "type": "string"
                                    },
                                    "message": {
                                      "type": "string"
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "errorFile": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "properties": {
                        "fileName": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string"
                        }
                      }
                    },
                    "summary": {
                      "type": "object",
                      "properties": {
                        "total": {
                          "type": "integer"
                        },
                        "inserted": {
                          "type": "integer"
                        },
                        "updated": {
                          "type": "integer"
                        },
                        "skipped": {
                          "type": "integer"
                        }
                      }
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": [
                              "integer",
                              "string"
                            ]
                          },
                          "text": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  },
                  "required": [
                    "status",
                    "title",
                    "message"
                  ]
                }
              }
            },
            "Respond_error": {
              "runAfter": {
                "Parse_error_body": [
                  "Succeeded"
                ]
              },
              "type": "Response",
              "kind": "PowerApp",
              "inputs": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "title": "status",
                      "type": "string",
                      "x-ms-content-hint": "TEXT",
                      "x-ms-dynamically-added": true
                    },
                    "response": {
                      "title": "response",
                      "type": "string",
                      "x-ms-content-hint": "TEXT",
                      "x-ms-dynamically-added": true
                    },
                    "success": {
                      "title": "success",
                      "type": "boolean",
                      "x-ms-content-hint": "BOOLEAN",
                      "x-ms-dynamically-added": true
                    },
                    "success_num": {
                      "title": "success_num",
                      "type": "number",
                      "x-ms-content-hint": "NUMBER",
                      "x-ms-dynamically-added": true
                    },
                    "error": {
                      "title": "error",
                      "type": "string",
                      "x-ms-content-hint": "TEXT",
                      "x-ms-dynamically-added": true
                    },
                    "errorFile": {
                      "title": "errorFile",
                      "type": "string",
                      "x-ms-content-hint": "TEXT",
                      "x-ms-dynamically-added": true
                    }
                  },
                  "additionalProperties": {}
                },
                "statusCode": 200,
                "body": {
                  "status": "error",
                  "response": "@{string(body('Parse_error_body'))}",
                  "success": false,
                  "success_num": 0,
                  "error": "@{body('Parse_error_body')?['message']}",
                  "errorFile": "@{coalesce(body('Parse_error_body')?['errorFile']?['url'],'')}"
                }
              }
            },
            "Respond_error_no_api": {
              "runAfter": {
                "Parse_error_body": [
                  "Failed",
                  "Skipped",
                  "TimedOut"
                ]
              },
              "type": "Response",
              "kind": "PowerApp",
              "inputs": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "title": "status",
                      "type": "string",
                      "x-ms-content-hint": "TEXT",
                      "x-ms-dynamically-added": true
                    },
                    "response": {
                      "title": "response",
                      "type": "string",
                      "x-ms-content-hint": "TEXT",
                      "x-ms-dynamically-added": true
                    },
                    "success": {
                      "title": "success",
                      "type": "boolean",
                      "x-ms-content-hint": "BOOLEAN",
                      "x-ms-dynamically-added": true
                    },
                    "success_num": {
                      "title": "success_num",
                      "type": "number",
                      "x-ms-content-hint": "NUMBER",
                      "x-ms-dynamically-added": true
                    },
                    "error": {
                      "title": "error",
                      "type": "string",
                      "x-ms-content-hint": "TEXT",
                      "x-ms-dynamically-added": true
                    },
                    "errorFile": {
                      "title": "errorFile",
                      "type": "string",
                      "x-ms-content-hint": "TEXT",
                      "x-ms-dynamically-added": true
                    }
                  },
                  "additionalProperties": {}
                },
                "statusCode": 200,
                "body": {
                  "status": "error",
                  "response": "{\"status\": \"error\", \"title\": \"インポートエラー\", \"message\": \"接続切断によりインポート処理が中断されました。\\nデータ整合性を保つため、データは保存されていません。\\nファイル全体を再度インポートしてください。\", \"error\": {\"code\": 56, \"reason\": null, \"rowCount\": 0, \"rows\": []}, \"errorFile\": null, \"summary\": {\"total\": 0, \"inserted\": 0, \"updated\": 0, \"skipped\": 0}, \"messages\": [{\"id\": 56, \"text\": \"接続切断によりインポート処理が中断されました。データ整合性を保つため、データは保存されていません。ファイル全体を再度インポートしてください。\"}]}",
                  "success": false,
                  "success_num": 0,
                  "error": "接続切断によりインポート処理が中断されました。\nデータ整合性を保つため、データは保存されていません。\nファイル全体を再度インポートしてください。",
                  "errorFile": ""
                }
              }
            }
          }
        }
      }
    },
    "outputs": {}
  },
  "connectionReferences": {}
}
