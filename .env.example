# ---------------------------------------------------------------------------
# Microsoft Graph auth (DefaultAzureCredential)
# Local dev: app registration client secret.
# In Azure Container Apps: delete SECRET/TENANT and set AZURE_CLIENT_ID to the
# user-assigned managed identity's client id instead.
# ---------------------------------------------------------------------------
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Planner target
PLAN_ID=
UPLOAD_FOLDER=DonHang

# ---------------------------------------------------------------------------
# Who may upload (Entra ID). Separate from the Graph auth above: the service
# always calls Graph as itself, whoever uploaded.
# AUTH_AUDIENCE = this API's Application ID URI, or its client id. List both
# forms comma-separated if callers may send either.
# ---------------------------------------------------------------------------
AUTH_ENABLED=true
AUTH_AUDIENCE=api://<api-app-client-id>
# AUTH_TENANT_ID=            # defaults to AZURE_TENANT_ID
AUTH_REQUIRED_SCOPE=access_as_user
# AUTH_REQUIRE_DELEGATED=true  # reject app-only tokens (uploads must be a person)

# ---------------------------------------------------------------------------
# Extraction: "vlm" (image -> vision model) or "ocr_llm" (image -> Azure DI -> LLM)
# ---------------------------------------------------------------------------
EXTRACTOR=vlm

LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-5.2
# Azure OpenAI instead of OpenRouter:
# LLM_BASE_URL=https://YOUR_RESOURCE.openai.azure.com/openai/v1
# LLM_MODEL=<deployment-name>
# LLM_API_VERSION=

# Only needed when EXTRACTOR=ocr_llm
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# ---------------------------------------------------------------------------
# Routing thresholds
# ---------------------------------------------------------------------------
DIRECTORY_PATH=config/directory.yaml
MIN_CONFIDENCE=0.35
MIN_DEPARTMENT_SCORE=70
MIN_EMPLOYEE_SCORE=70

LOG_LEVEL=INFO
PORT=8000

# ---------------------------------------------------------------------------
# Deployment (./deploy.sh). Only ACR_NAME is required; the rest have defaults.
# ACR_NAME must be globally unique: 5-50 lowercase letters/digits, nothing else.
# ---------------------------------------------------------------------------
ACR_NAME=
RESOURCE_GROUP=rg-planner-app
LOCATION=southeastasia
APP_NAME=planner-app
# Bump this on every redeploy - Container Apps will not re-pull the same tag.
IMAGE_TAG=v1
MIN_REPLICAS=1
# INGRESS=external

