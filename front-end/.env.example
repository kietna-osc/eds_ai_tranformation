# Local overrides.
# Prefer proxy target (same-origin /api → backend). Avoid VITE_AI_SERVICE_URL in browser
# unless the API has CORS configured for this origin.
#
# Local ai-service:
# AI_SERVICE_PROXY_TARGET=http://localhost:8600
#
# Azure Container Apps:
# AI_SERVICE_PROXY_TARGET=https://ai-service.calmpond-b38320fc.japaneast.azurecontainerapps.io

# Microsoft Entra ID (Azure AD) — SPA sign-in
# Create an App registration (SPA) + expose API scope access_as_user
# VITE_AZURE_AD_CLIENT_ID=
# VITE_AZURE_AD_TENANT_ID=
# Optional; default api://{CLIENT_ID}/access_as_user
# VITE_AZURE_AD_API_SCOPE=api://YOUR_CLIENT_ID/access_as_user
